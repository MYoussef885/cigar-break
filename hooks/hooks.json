{
  "description": "Cigar: session fatigue detection and handoff restore",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/cigar-hook",
              "session_start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/cigar-hook",
              "post_tool_use"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/cigar-hook",
              "post_tool_use_failure"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/cigar-hook",
              "post_model_switch"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/cigar-hook",
              "pre_compact"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/cigar-hook",
              "stop"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/cigar-hook",
              "session_end"
            ],
            "timeout": 2
          }
        ]
      }
    ]
  }
}
